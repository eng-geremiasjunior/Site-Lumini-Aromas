# =============================================================================
# Lumini Aromas - variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# Em produção, cadastre estes valores nas Environment Variables da Vercel.
# =============================================================================

# --- Banco de dados (Supabase, região South America / sa-east-1) -----------
# A região do projeto não pode ser trocada depois de criado: crie em
# sa-east-1 (São Paulo) desde o início.
DATABASE_URI=postgresql://usuario:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Payload ---------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# URL pública do site (sem barra no final).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Cloudflare R2 (imagens, logos dos clientes, provas de arte) -----------
S3_BUCKET=lumini-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
# Domínio público do bucket, usado para montar a URL das imagens.
NEXT_PUBLIC_S3_PUBLIC_URL=

# --- Mercado Pago ----------------------------------------------------------
# Credenciais de teste começam com TEST-, as de produção com APP_USR-.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Segredo do webhook, gerado ao salvar a URL em Suas integrações > Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Melhor Envio ----------------------------------------------------------
# Ambiente: sandbox durante o desenvolvimento, production no go-live.
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Obrigatório pela API: nome do app e e-mail de contato.
MELHOR_ENVIO_USER_AGENT=Lumini Aromas (atendimento@luminiaromas.com.br)
MELHOR_ENVIO_WEBHOOK_SECRET=
# CEP de origem das postagens (ateliê).
MELHOR_ENVIO_CEP_ORIGEM=35020720

# --- Meta (Pixel + Conversions API) ---------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=1266635820732859
META_CAPI_ACCESS_TOKEN=
# Preencha apenas em homologação, para os eventos aparecerem em Testar eventos.
META_CAPI_TEST_EVENT_CODE=
# Conta do WhatsApp Business, usada nos eventos de venda fechada no WhatsApp.
META_WABA_ID=

# --- Google (GA4, Ads, Merchant) ------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-ZZVS0YHWXH
NEXT_PUBLIC_GTM_ID=GTM-M4XTGVP
# Criado em Admin > Fluxos de dados > Measurement Protocol. Nunca vai ao front.
GA4_API_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
# Service account JSON em base64, para Merchant API e Data Manager API.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- E-mail transacional (Resend) -----------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Lumini Aromas <pedidos@luminiaromas.com.br>
EMAIL_ADMIN=atendimento@luminiaromas.com.br

# --- WhatsApp -------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=5533999478774
# Preenchidos apenas quando o número entrar em coexistência com a Cloud API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Segurança ------------------------------------------------------------
# Cloudflare Turnstile (gratuito) no login, checkout e formulários.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Protege as rotas de cron da Vercel contra chamadas externas.
CRON_SECRET=

# --- Migração do WooCommerce ----------------------------------------------
WOO_BASE_URL=https://luminiaromas.com.br
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
